# port, auf dem der server lauscht
PORT=3000

# "development" oder "production"
NODE_ENV=development

# pfad zur sqlite-datei (relativ zum projekt-root oder absolut)
DATABASE_PATH=./data/lumiswork.db

# secret fuer session-cookies — WIRD ERST FUER DEN ADMIN-LOGIN GEBRAUCHT.
# vor dem produktiv-einsatz durch einen zufallswert ersetzen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-ersetzen

# setzen, wenn der server hinter einem reverse proxy (nginx/caddy) laeuft.
# sorgt dafuer, dass rate-limiting und secure-cookies die echte client-ip sehen.
TRUST_PROXY=0

# gueltigkeit einer admin-session in tagen
SESSION_DAYS=14

# obergrenze pro hochgeladener datei in megabyte. 0 schaltet das limit ab.
# der reverse proxy braucht dann ein passendes eigenes limit — siehe SETUP.md.
MAX_UPLOAD_MB=500
